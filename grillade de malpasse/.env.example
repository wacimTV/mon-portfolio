# ───────────────────────────────────────────────────────────────
# La Grillade de Malpa — variables d'environnement (exemple)
# Copiez ce fichier en .env et remplissez les valeurs.
# NE JAMAIS committer le fichier .env
# ───────────────────────────────────────────────────────────────

# URL publique du site (sans / final) — utilisée pour le SEO (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://www.lagrilladedemalpa.fr"

# Base de données SQLite (chemin relatif au dossier du projet)
DATABASE_URL="file:./data/grillade.db"

# Dossier de stockage des photos uploadées depuis l'admin (persistant !)
UPLOAD_DIR="./data/uploads"

# ── Administration ─────────────────────────────────────────────
# Email de connexion admin
ADMIN_EMAIL="admin@example.com"
# Hash bcrypt du mot de passe, encodé en base64 (évite les problèmes avec le caractère $)
# Générez-le avec : npm run admin:hash -- "VotreMotDePasseTrèsLong"
ADMIN_PASSWORD_HASH_B64=""
# Secret de signature des sessions (32 caractères minimum, aléatoire)
# Générez-le avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# ── Emails (SMTP) ──────────────────────────────────────────────
# Sans SMTP_HOST, les emails sont simplement affichés dans la console (mode dev).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Expéditeur des emails
MAIL_FROM="La Grillade de Malpa <no-reply@lagrilladedemalpa.fr>"
# Adresse qui reçoit les réservations, commandes Click & Collect et messages de contact
RESTAURANT_EMAIL="contact@lagrilladedemalpa.fr"

# ── Statistiques de visite sans cookies (optionnel : Plausible ou Umami) ──
# Laissez vide pour désactiver. Aucun bandeau cookies n'est requis avec ces outils.
NEXT_PUBLIC_ANALYTICS_DOMAIN=""
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL="https://plausible.io/js/script.js"
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
NEXT_PUBLIC_UMAMI_SCRIPT_URL="https://cloud.umami.is/script.js"


